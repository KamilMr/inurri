---
import { defaultLang } from '~/i18n/ui';
import { useTranslations } from '~/i18n/utils';
import HeroCentered from './hero/HeroCentered.astro';
import type { HeroCta } from './hero/types';

interface Props {
  badge?: string;
  title?: string;
  highlight?: string;
  description?: string;
  primaryCta?: HeroCta;
  secondaryCta?: HeroCta;
}

const { lang = defaultLang } = Astro.params;
const t = useTranslations(lang);

const {
  badge = t['hero.badge'],
  title = t['hero.title'],
  highlight = t['hero.highlight'],
  description = t['hero.subtitle'],
  primaryCta = { text: t['hero.getStarted'], href: `/${lang}/contact` },
  secondaryCta = { text: t['hero.learnMore'], href: `/${lang}/portfolio` },
} = Astro.props;

const heroProps = { badge, title, highlight, description, primaryCta, secondaryCta };
---
<HeroCentered {...heroProps} />
